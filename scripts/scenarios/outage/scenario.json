{
  "id": "outage",
  "title": "Outage drill - retriever hard-down, every request 502s",
  "layer": "app",
  "group": "inference",
  "inject_mode": "live",
  "needs": ["k8s"],
  "load": { "profile": "steady", "qps": 40 },
  "drill_dwell_s": 240,
  "expected_time_to_alert_s": 120,
  "exam": false,
  "chaos": {
    "service": "retriever",
    "knobs": { "outage": true },
    "confirm": { "knob": "outage", "equal_to": true },
    "signal": { "kind": "server-errors", "at_least": 10, "probes": 12 }
  }
}
